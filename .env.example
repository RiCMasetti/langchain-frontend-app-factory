# Model provider for LangChain's init_chat_model(). Any provider langchain supports works
# (anthropic, openai, google_genai, bedrock_converse, ...) as long as the matching
# langchain-<provider> package and its credentials are installed/set.
#
# Using Anthropic models via AWS Bedrock: set both providers to bedrock_converse, use
# the Bedrock model ID or cross-region inference profile ID enabled in your AWS
# account, `uv sync --extra bedrock`, and set AWS_BEARER_TOKEN_BEDROCK below (Bedrock
# API key auth -- no full AWS credentials/profile needed).
PLANNER_MODEL_PROVIDER=bedrock_converse
PLANNER_MODEL_NAME=<claude-sonnet-bedrock-model-or-inference-profile-id>
WORKER_MODEL_PROVIDER=bedrock_converse
WORKER_MODEL_NAME=<claude-haiku-bedrock-model-or-inference-profile-id>

# Bedrock API key (bearer token) auth. ModelConfig.init_chat_model() reads this
# directly and passes it as bedrock_api_key to ChatBedrockConverse when the provider
# is bedrock/bedrock_converse -- takes precedence over any AWS credentials/profile.
AWS_BEARER_TOKEN_BEDROCK=xxxxxxxxx
BEDROCK_REGION=us-east-1
# AWS_REGION / AWS_DEFAULT_REGION are also honored, in that priority order.

# ANTHROPIC_API_KEY=xxxxxxxxx     # only needed if PLANNER/WORKER_MODEL_PROVIDER=anthropic
# OPENAI_API_KEY=xxxxxxxxx        # only needed if PLANNER/WORKER_MODEL_PROVIDER=openai

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=frontend-app-factory
# LANGSMITH_API_KEY=xxxxxxxxx

WORKSPACE_DIR=./workspace
MAX_AGENT_ITERATIONS=5
AGENT_CALL_TIMEOUT_SECONDS=900
CHECKPOINT_BACKEND=sqlite

# Max tool-calling turns for App Writer / Test Writer before the node gives up (each
# file write is one turn). A moderately complex plan (~5 components + config/data
# files) can take ~20 turns -- these defaults leave real headroom above that.
APP_WRITER_MAX_STEPS=60
TEST_WRITER_MAX_STEPS=40

# Optional cost estimation. Values are cost per 1M tokens.
PLANNER_INPUT_USD_PER_1M=0
PLANNER_OUTPUT_USD_PER_1M=0
WORKER_INPUT_USD_PER_1M=0
WORKER_OUTPUT_USD_PER_1M=0
